# Environment Variables Template
# Copy this file to .env and fill in actual values for local development

# Keystore configuration for release builds
KEYSTORE_PATH=./my-upload-key.jks
STORE_PASSWORD=your_store_password_here
KEY_PASSWORD=your_key_password_here

# Firebase App Check Debug Token (optional for development)
FIREBASE_APPCHECK_DEBUG_TOKEN=your_debug_token_here
